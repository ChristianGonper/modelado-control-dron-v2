% Anejos.
\newcounter{appendixcounter}
\renewcommand{\theappendixcounter}{\arabic{appendixcounter}}
\newcommand{\myappendix}[1]{%
  \cleardoublepage
  \thispagestyle{empty}
  \refstepcounter{appendixcounter}
  \vspace*{\fill}
  \begin{center}
    \parbox{0.9\textwidth}{\centering\Huge\bfseries Anejo \theappendixcounter. #1}
  \end{center}
  \vspace*{\fill}
  \addcontentsline{toc}{section}{Anejo \theappendixcounter: #1}
  \cleardoublepage
}
